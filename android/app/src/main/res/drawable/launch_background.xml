<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Splash background: theme color (light #005EB2 / dark #1C2125) -->
    <item android:drawable="@color/ic_launcher_background" />

    <!-- Dedicated splash foreground (not the adaptive foreground, so it is not clipped by the icon mask).
         Centered; intrinsic size chosen so the whole mark fits ~40-50% of screen width. -->
    <item android:gravity="center">
        <bitmap android:src="@drawable/splash_foreground" android:gravity="center" />
    </item>
</layer-list>
